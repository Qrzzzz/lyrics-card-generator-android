<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Non-exported host for Compose instrumentation against the exact minified release APK. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:replace="android:exported" />

        <!--
          The receiver class is supplied by ProfileInstaller's runtime-only AAR, so lint's
          compile-classpath model cannot resolve it even though manifest merging and packaging do.
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:replace="android:exported" />
    </application>

</manifest>
