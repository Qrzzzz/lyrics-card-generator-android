{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Qrzzzz/lyrics-card-generator-android/blob/main/config/device-gate-evidence.schema.json",
  "title": "Lyrics Card Generator Android final device gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "testFixture",
    "status",
    "candidate",
    "run",
    "environments",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "lyrics-card-final-device-gate" },
    "testFixture": { "type": "boolean" },
    "status": { "enum": ["READY", "NOT RUN", "BLOCKED"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "candidateRunId",
        "candidateRunAttempt",
        "candidateArtifactName",
        "qualityGateRunId",
        "releaseMetadataSha256",
        "package",
        "versionName",
        "versionCode",
        "productionApk",
        "productionAab",
        "testApk"
      ],
      "properties": {
        "repository": { "const": "Qrzzzz/lyrics-card-generator-android" },
        "sourceCommit": { "$ref": "#/definitions/commitSha" },
        "candidateRunId": { "type": "integer", "minimum": 1 },
        "candidateRunAttempt": { "type": "integer", "minimum": 1 },
        "candidateArtifactName": { "type": "string", "pattern": "^production-candidate-[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{12}$" },
        "qualityGateRunId": { "type": "integer", "minimum": 1 },
        "releaseMetadataSha256": { "$ref": "#/definitions/sha256" },
        "package": { "const": "com.qrzzzz.lyricscard" },
        "versionName": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "versionCode": { "type": "integer", "minimum": 1 },
        "productionApk": {
          "allOf": [
            { "$ref": "#/definitions/releaseArtifact" },
            { "properties": { "name": { "pattern": "^lyrics-card-generator-android-[0-9]+\\.[0-9]+\\.[0-9]+\\.apk$" } } }
          ]
        },
        "productionAab": {
          "allOf": [
            { "$ref": "#/definitions/releaseArtifact" },
            { "properties": { "name": { "pattern": "^lyrics-card-generator-android-[0-9]+\\.[0-9]+\\.[0-9]+\\.aab$" } } }
          ]
        },
        "testApk": {
          "allOf": [
            { "$ref": "#/definitions/releaseArtifact" },
            {
              "type": "object",
              "required": ["package", "targetPackage", "versionName", "versionCode"],
              "properties": {
                "package": { "type": "string", "minLength": 1 },
                "targetPackage": { "type": "string", "minLength": 1 },
                "versionName": { "type": "string" },
                "versionCode": { "type": "integer", "minimum": 0 },
                "name": { "pattern": "^[A-Za-z0-9._-]+\\.apk$" }
              }
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowRunId", "workflowRunAttempt", "workflowPath", "workflowEvent", "artifactName", "startedAt", "completedAt", "runner", "authorizationReference", "stopOnFirstFailure"],
      "properties": {
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "workflowRunAttempt": { "type": "integer", "minimum": 1 },
        "workflowPath": { "const": ".github/workflows/capture-device-gate-evidence.yml" },
        "workflowEvent": { "const": "workflow_dispatch" },
        "artifactName": { "type": "string", "pattern": "^final-device-evidence-[A-Za-z0-9._-]+$" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "runner": { "type": "string", "minLength": 1 },
        "authorizationReference": { "type": "string", "minLength": 1 },
        "stopOnFirstFailure": { "const": true }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/environment" }
    },
    "gates": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/gate" }
    }
  },
  "definitions": {
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "releaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "certificateSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "certificateSha256": { "$ref": "#/definitions/sha256" },
        "package": { "type": "string", "minLength": 1 },
        "targetPackage": { "type": "string", "minLength": 1 },
        "versionName": { "type": "string" },
        "versionCode": { "type": "integer", "minimum": 0 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "apiLevel",
        "androidVersion",
        "systemImage",
        "deviceIdSha256",
        "ramMiB",
        "webView",
        "installedArtifacts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["AVD", "PHYSICAL"] },
        "apiLevel": { "type": "integer", "minimum": 26 },
        "androidVersion": { "type": "string", "minLength": 1 },
        "systemImage": { "type": "string", "minLength": 1 },
        "deviceIdSha256": { "$ref": "#/definitions/sha256" },
        "ramMiB": { "type": "integer", "minimum": 1024 },
        "avdName": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "securityPatch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "authorizationReference": { "type": "string", "minLength": 1 },
        "webView": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version"],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "installedArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceCommit", "package", "versionName", "versionCode", "productionApkSha256", "testApkSha256", "certificateSha256", "testCertificateSha256"],
          "properties": {
            "sourceCommit": { "$ref": "#/definitions/commitSha" },
            "package": { "type": "string", "minLength": 1 },
            "versionName": { "type": "string", "minLength": 1 },
            "versionCode": { "type": "integer", "minimum": 1 },
            "productionApkSha256": { "$ref": "#/definitions/sha256" },
            "testApkSha256": { "$ref": "#/definitions/sha256" },
            "certificateSha256": { "$ref": "#/definitions/sha256" },
            "testCertificateSha256": { "$ref": "#/definitions/sha256" }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environmentId", "status", "attempts", "testSelector", "startedAt", "completedAt", "logs"],
      "properties": {
        "id": {
          "enum": [
            "api26-core",
            "api26-renderer-webview",
            "api26-recovery-atf",
            "api30-serif-measure-spec-1x-2x",
            "api30-export-20x",
            "api30-cancel-retry-temp-cleanup",
            "api30-memory",
            "api33-core",
            "api33-recovery-atf",
            "api33-talkback",
            "api33-font-scale-200",
            "api36-connected-production",
            "api36-export-20x",
            "four-gb-2x-memory",
            "endurance-30m",
            "physical-core-save-share"
          ]
        },
        "environmentId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT RUN", "BLOCKED"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "testSelector": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "logs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256"],
            "properties": {
              "kind": { "enum": ["instrumentation", "logcat", "manual"] },
              "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
              "sha256": { "$ref": "#/definitions/sha256" }
            }
          }
        }
      }
    }
  }
}
