{
  "name": "@lyrics-card/android-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:validator": "node scripts/generate-render-spec-validator.mjs",
    "check:validator": "node scripts/generate-render-spec-validator.mjs --check",
    "predev": "npm run generate:validator",
    "pretypecheck": "npm run check:validator",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run check:validator",
    "test": "vitest run",
    "prebuild": "npm run check:validator",
    "build": "vite build",
    "audit:security": "node scripts/audit-security.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "golden": "npm run golden:test",
    "golden:install": "playwright install chromium",
    "golden:test": "node scripts/run-pixel-golden.mjs",
    "golden:update": "node scripts/run-pixel-golden.mjs --update",
    "renderer:typecheck": "npm run typecheck",
    "renderer:test": "npm run test",
    "renderer:build": "npm run build",
    "renderer:golden": "npm run golden"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "html-to-image": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "ssim.js": "3.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "engines": {
    "node": ">=20"
  }
}
